NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
GEMINI_API_KEY=your-gemini-api-key-here

# Control de costo (Track B / migración 003). Sin esta key, la app funciona en
# modo fallback (rate-limit en memoria + cuota diaria basada en sesiones
# terminadas, sin control de concurrencia). Con ella, se activan los RPC de
# cuota atómica + concurrencia + rate-limit distribuido.
# Sácala de Supabase → Project Settings → API → service_role (NUNCA con prefijo
# NEXT_PUBLIC_, no debe llegar al cliente).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Opcional — tarifas para estimar costo de IA en los logs (valores por defecto si se omiten)
# VERTEX_VOICE_USD_PER_MIN=0.05
# GEMINI_FLASH_INPUT_USD_PER_MTOK=0.15
# GEMINI_FLASH_OUTPUT_USD_PER_MTOK=0.60
